                "type": "reverseFieldRef",
                "group": "rbac.authorization.k8s.io",
                "kind": "RoleBinding",
                "items": "$.subjects[?(@.kind=='Group')]",
                "match": { "name": "system:serviceaccounts:${namespace}" },
                "allNamespaces": true
              },
              "children": [
