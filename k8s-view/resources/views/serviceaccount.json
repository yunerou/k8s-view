{
  "$schema": "../../schemas/k8s-view.schema.json",
  "version": 1,
  "views": [
    {
      "id": "serviceaccount",
      "title": "ServiceAccount",
      "icon": "account",
      "order": 5,
      "sections": [
        {
          "id": "serviceaccounts",
          "title": "ServiceAccounts",
          "icon": "account",
          "resources": [{ "kind": "ServiceAccount" }],
          "columns": [
            { "title": "Secrets", "path": "$.secrets", "render": "count", "default": "0" },
            {
              "title": "Automount token",
              "path": "$.automountServiceAccountToken",
              "render": "boolean",
              "default": "Yes"
            },
            { "title": "Age", "path": "$.metadata.creationTimestamp", "render": "age" }
          ],
          "children": [
            {
              "id": "rolebindings",
              "title": "RoleBindings",
              "relation": {
                "type": "reverseFieldRef",
                "group": "rbac.authorization.k8s.io",
                "kind": "RoleBinding",
                "items": "$.subjects[?(@.kind=='ServiceAccount')]",
                "match": { "name": "${name}", "namespace": "${namespace}" },
                "allNamespaces": true
              },
              "children": [
                {
                  "id": "role",
                  "relation": {
                    "type": "fieldRef",
                    "items": "$.roleRef",
                    "group": { "path": "$.apiGroup", "default": "rbac.authorization.k8s.io" },
                    "kind": { "path": "$.kind", "default": "Role" }
                  }
                }
              ]
            },
            {
              "id": "rolebindings-ns-group",
              "title": "RoleBindings (group system:serviceaccounts:<ns>)",
